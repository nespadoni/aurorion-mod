{
  "processors": [
    {
      "processor_type": "minecraft:rule",
      "rules": [
        {
          "input_predicate": { "predicate_type": "minecraft:block_match", "block": "minecraft:stone_bricks" },
          "location_predicate": { "predicate_type": "minecraft:always_true" },
          "position_predicate": { "predicate_type": "minecraft:always_true" },
          "output_state": { "Name": "minecraft:cracked_stone_bricks" }
        },
        {
          "input_predicate": { "predicate_type": "minecraft:random_block_match", "block": "minecraft:cracked_stone_bricks", "probability": 0.35 },
          "location_predicate": { "predicate_type": "minecraft:always_true" },
          "position_predicate": { "predicate_type": "minecraft:always_true" },
          "output_state": { "Name": "minecraft:mossy_stone_bricks" }
        },
        {
          "input_predicate": { "predicate_type": "minecraft:random_block_match", "block": "minecraft:cracked_stone_bricks", "probability": 0.12 },
          "location_predicate": { "predicate_type": "minecraft:always_true" },
          "position_predicate": { "predicate_type": "minecraft:always_true" },
          "output_state": { "Name": "minecraft:air" }
        }
      ]
    }
  ]
}
